# Copiar a .env.local para cambiar algo. En desarrollo, sin ese archivo se usan estos valores.
# En producción NEXT_PUBLIC_API_URL es obligatoria: sin ella, el build falla.
# Todo lo que empieza con NEXT_PUBLIC_ queda visible en el navegador: nunca poner secretos acá.

# URL base de la API, con /api y sin "/" final.
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Solo del servidor de Next. Dirección de la API vista desde el servidor, si no es la misma que
# ve el navegador (por ejemplo, en Docker: http://api:3000/api). Si no se define, usa la de arriba.
# API_INTERNAL_URL=
