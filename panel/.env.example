# Copiar a .env.local para cambiar algo. En desarrollo, sin ese archivo se usan estos valores.
# En producción VITE_API_URL es obligatoria: sin ella, el panel no arranca.
# Todo lo que empieza con VITE_ queda visible en el navegador: nunca poner secretos acá.

# URL base de la API, con /api y sin "/" final.
VITE_API_URL=http://localhost:3000/api
